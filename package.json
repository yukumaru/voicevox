{
  "name": "voicevox-chat",
  "version": "1.0.0",
  "description": "VOICEVOX \u00d7 Claude \u97f3\u58f0\u4f1a\u8a71\u30a2\u30d7\u30ea",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.voicevox.chat",
    "productName": "VoiceChat",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "form-data": "^4.0.0"
  }
}